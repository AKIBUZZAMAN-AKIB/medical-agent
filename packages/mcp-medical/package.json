{
  "name": "@librechat/mcp-medical",
  "version": "0.2.0",
  "description": "Keyless medical & clinical decision MCP server for LibreChat: 33 live biomedical and deterministic emergency-screening, pharmacogenomic (CPIC), Bangladesh formulary (BDDrugBank 24,725 brands), clinical calculator (MedCalc), lab panel, and specialist sub-agent orchestration tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "librechat-mcp-medical": "dist/index.js"
  },
  "files": [
    "dist",
    "agent",
    "data"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent/instructions.md": "./agent/instructions.md",
    "./agent/agent.json": "./agent/agent.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:ci": "jest --ci",
    "smoke": "node scripts/smoke.mjs",
    "eval": "node eval/run.mjs",
    "verify": "npm run typecheck && npm run test:ci",
    "test:e2e-emergency": "node scripts/emergency-e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danny-avila/LibreChat"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danny-avila/LibreChat/issues"
  },
  "homepage": "https://librechat.ai",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^24.12.4",
    "jest": "^30.2.0",
    "jest-junit": "^17.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "mcp",
    "medical",
    "agents",
    "pubmed",
    "openfda",
    "rxnorm",
    "clinicaltrials",
    "librechat"
  ]
}
